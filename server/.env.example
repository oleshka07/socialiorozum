# --- App ---
PORT=8080
NODE_ENV=production

# --- Postgres (внутрішня БД у docker-compose) ---
POSTGRES_USER=kontentgrov
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=kontentgrov
# DATABASE_URL для застосунку (host=db -> ім'я сервісу в compose)
DATABASE_URL=postgres://kontentgrov:change_me_strong@db:5432/kontentgrov

# --- OpenRouter ---
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# заголовки рекомендовані OpenRouter (необов'язково)
OPENROUTER_REFERER=https://your-domain.example
OPENROUTER_TITLE=KontentGrov

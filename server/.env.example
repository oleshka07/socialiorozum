# --- App ---
PORT=8080
NODE_ENV=production
# базовий публічний URL (для посилань у листах верифікації/скидання)
APP_BASE_URL=https://socialio.rozum.one
# секрет для підпису cookie-сесій (згенеруй: openssl rand -hex 32)
SESSION_SECRET=change_me_long_random

# --- Email (Resend) для верифікації пошти й скидання пароля ---
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=socialio <noreply@rozum.one>

# --- Google OAuth (вхід через Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# redirect URI у Google Console: https://socialio.rozum.one/api/auth/google/callback

# --- адмін(и) для перегляду журналу /api/admin/logs (через кому) ---
ADMIN_EMAILS=o.stepeniev@swipescape.eu,stepenievgroup@gmail.com

# --- Postgres (внутрішня БД у docker-compose) ---
POSTGRES_USER=kontentgrov
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=kontentgrov
# DATABASE_URL для застосунку (host=db -> ім'я сервісу в compose)
DATABASE_URL=postgres://kontentgrov:change_me_strong@db:5432/kontentgrov

# --- OpenRouter ---
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# заголовки рекомендовані OpenRouter (необов'язково)
OPENROUTER_REFERER=https://your-domain.example
OPENROUTER_TITLE=KontentGrov

# --- OpenAI (пряма генерація Lite + gpt-image-1) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# --- БЕТА (тільки для /opt/socialio-beta/.env; на ПРОДІ ці рядки НЕ задавати) ---
# COMPOSE_PROJECT_NAME=socialio-beta      # окремий docker-проєкт: свої контейнери/БД/volumes
# APP_PORT=8081                           # прод слухає 8080, бета 8081 (nginx: beta.socialio.rozum.one -> 8081)
# APP_BASE_URL=https://beta.socialio.rozum.one
# BETA_PIN=2345                           # PIN-гейт на вході (сторінка «Введи PIN», кукі 30 днів)
# TELEGRAM_WEBHOOK_OFF=1                  # ОБОВ'ЯЗКОВО на беті зі спільним ботом: не красти webhook у прода

# --- Відео-рілси (прототип, бета): укр. озвучка + стоковий b-roll ---
# Azure Speech (portal.azure.com → створити ресурс "Speech" → безкоштовний тариф F0 → Keys and Endpoint)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
# AZURE_SPEECH_VOICE=uk-UA-PolinaNeural   # жіночий (дефолт); чоловічий: uk-UA-OstapNeural
# Pexels (pexels.com/api → безкоштовний ключ) - вертикальні стокові кліпи + стокові ФОТО в редакторі
PEXELS_API_KEY=

# --- Публікація рілсів: YouTube Shorts + TikTok ---
# YouTube реюзає GOOGLE_CLIENT_ID/SECRET: у Google Cloud Console увімкни "YouTube Data API v3"
# і додай redirect https://<домен>/api/integrations/youtube/callback (+ scope youtube.upload у consent screen)
# TikTok: застосунок на developers.tiktok.com (Content Posting API, scope user.info.basic + video.upload);
# до аудиту TikTok відео їде юзеру в чернетки (inbox upload)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Gemini (Google AI Studio): зображення Nano Banana + бюджетний текст ---
GEMINI_API_KEY=AIza_xxxxxxxxxxxxxxxx
# Модель для ДЕШЕВИХ/неважливих кроків (метчинг слотів, теми плану, ідеї, хештеги, інсайти).
# За замовч. openai/gpt-4o-mini. Щоб гнати їх на безкоштовний Gemini — розкоментуй:
# CHEAP_MODEL=google/gemini-2.5-flash

# 💸 Стеля витрат на AI (на воркспейс). 0 = без обмеження. Окремому кабінету адмін задає свою в кабінеті.
SPEND_CAP_USD_DAY=3
SPEND_CAP_USD_MONTH=30
SPEND_CALLS_PER_MIN=40
# Після схвалення Meta App Review постав 1 - Instagram стане головною кнопкою онбордингу для всіх.
# До того OAuth Meta працює лише для Testers, тож онбординг починає з тексту.
META_PUBLIC=0
